<?xml version="1.0"?>
<package format="3">
  <name>visbot_control</name>
  <version>1.0.0</version>
  <description>120 Hz bounded-latency control loop, fast plant backend, and RT benchmark for the SysVRC sim testbed.</description>
  <maintainer email="amil@amilcodes.dev">Amil Agrawal</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visbot_msgs</depend>
  <depend>visbot_core</depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
